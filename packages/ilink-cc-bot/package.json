{
  "name": "@pawastation/ilink-cc-bot",
  "version": "0.2.0",
  "description": "WeChat iLink Bot channel for Claude Code",
  "author": "pawaca <pawaca@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pawastation/wechat-ilink-bot.git",
    "directory": "packages/ilink-cc-bot"
  },
  "homepage": "https://github.com/pawastation/wechat-ilink-bot/tree/main/packages/ilink-cc-bot",
  "bugs": {
    "url": "https://github.com/pawastation/wechat-ilink-bot/issues"
  },
  "keywords": [
    "wechat",
    "weixin",
    "ilink",
    "claude-code",
    "channel",
    "mcp",
    "bot"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    }
  },
  "bin": {
    "ilink-cc-bot": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "login": "node --import tsx src/cli.ts login",
    "start": "node --import tsx src/cli.ts start",
    "setup": "node --import tsx src/cli.ts setup",
    "prepublishOnly": "pnpm run build && pnpm run typecheck"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@pawastation/ilink-bot-sdk": "workspace:*",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
